{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-concurrency=1",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "cloudinary": "^2.7.0",
    "multer": "^2.0.2",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "mongodb-memory-server": "^10.2.0"
  }
}
